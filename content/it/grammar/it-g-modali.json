    { "id": "e2", "type": "choose", "q": "Tu ___ un caffè?", "es": "¿Quieres un café?", "options": ["vuoi", "vuole", "voglio"], "answer": "vuoi", "why": "Tu de volere: vuoi.", "g": "it-g-modali" },
    { "id": "e3", "type": "choose", "q": "Lui ___ lavorare domani.", "es": "Él tiene que trabajar mañana.", "options": ["deve", "devi", "dove"], "answer": "deve", "why": "Lui de dovere: deve. (Dove significa «dónde».)", "g": "it-g-modali" },
    { "id": "e4", "type": "choose", "q": "Signora, Lei ___ sedersi qui.", "es": "Señora, usted puede sentarse aquí.", "options": ["può", "puoi", "posso"], "answer": "può", "why": "Lei (usted) va como lui/lei: può.", "g": "it-g-modali" },
    { "id": "e5", "type": "choose", "q": "Noi ___ partire presto domani.", "es": "Tenemos que salir pronto mañana.", "options": ["dobbiamo", "doviamo", "devono"], "answer": "dobbiamo", "why": "Noi de dovere: dobbiamo.", "g": "it-g-modali" },
