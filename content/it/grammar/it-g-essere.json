  "title": "El verbo essere (ser y estar)",
  "short": "Sono, sei, è, siamo, siete, sono: el verbo más importante del italiano.",
  "story": [
    { "kind": "intro", "emoji": "🌟", "title": "Un verbo, dos en español",
      "text": "**Essere** significa **ser** y muchas veces también **estar**. ¡Un verbo que vale por dos!",
      "examples": [
        { "t": "Sono spagnola.", "es": "Soy española.", "hl": "Sono" },
        { "t": "Sono a Roma.", "es": "Estoy en Roma.", "hl": "Sono" }
      ] },
    { "kind": "table", "emoji": "📋", "title": "Así se conjuga",
      "text": "Apréndelo como una cancioncilla: sono, sei, è, siamo, siete, sono.",
      "table": { "head": ["Persona", "Essere", "Español"], "rows": [
        ["io", "==sono==", "soy"],
        ["tu", "==sei==", "eres"],
        ["lui / lei / Lei", "==è==", "es"],
        ["noi", "==siamo==", "somos"],
        ["voi", "==siete==", "sois"],
        ["loro", "==sono==", "son"]
      ] } },
    { "kind": "rule", "emoji": "👀", "title": "¡Ojo con sono!",
      "text": "**Sono** sirve para «yo soy» y para «ellos son». El contexto lo aclara.",
      "examples": [
        { "t": "Sono spagnola.", "es": "Soy española.", "hl": "Sono" },
        { "t": "Loro sono italiani.", "es": "Ellos son italianos.", "hl": "sono" }
      ] },
    { "kind": "rule", "emoji": "✍️", "title": "è con acento",
      "text": "**è** (con acento) = es. **e** (sin acento) = y. Lui ==è== italiano ==e== lei ==è== spagnola.",
      "examples": [{ "t": "Lui è italiano e lei è spagnola.", "es": "Él es italiano y ella es española.", "hl": "è" }] },
    { "kind": "compare", "emoji": "⚖️", "title": "¿Ser o estar?",
      "text": "Para el lugar se usa essere: ==Sono== a Roma (estoy en Roma). Pero para la salud se dice **Sto bene** (estoy bien)." },
    { "kind": "rule", "emoji": "💼", "title": "Profesiones, sin artículo",
      "text": "Como en español: ==Sono== insegnante. Mio figlio ==è== medico.",
      "examples": [{ "t": "Mio figlio è medico.", "es": "Mi hijo es médico.", "hl": "è" }] },
    { "kind": "tip", "emoji": "💡", "title": "Truco",
      "text": "No hace falta el pronombre: el verbo ya lo dice todo. **Sono** Yolanda, **sono** spagnola, **sono** a Roma. ¡Y listo!" }
  ],
  "compare": {
    "es": "En español tenemos dos verbos: ser (soy española) y estar (estoy en Roma).",
    "target": "En italiano, essere hace casi siempre los dos papeles: sono spagnola, sono a Roma. Solo para la salud se usa stare: sto bene."
  },
