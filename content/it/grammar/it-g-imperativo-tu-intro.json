    { "id": "e2", "type": "choose", "q": "___ la seconda a destra.", "es": "Coge la segunda a la derecha.", "options": ["Prendi", "Prenda", "Prende"], "answer": "Prendi", "why": "Prendere (-ere) con tu: prendi.", "g": "it-g-imperativo-tu-intro" },
    { "id": "e3", "type": "choose", "q": "___ dritto per due minuti.", "es": "Sigue recto dos minutos.", "options": ["Vai", "Anda", "Andi"], "answer": "Vai", "why": "Andare es irregular: vai (o va').", "g": "it-g-imperativo-tu-intro" },
    { "id": "e4", "type": "choose", "q": "Non ___ la strada qui!", "es": "¡No cruces la calle aquí!", "options": ["attraversare", "attraversa", "attraversi"], "answer": "attraversare", "why": "Negativo con tú: non + infinitivo.", "g": "it-g-imperativo-tu-intro" },
    { "id": "e5", "type": "choose", "q": "___ alla terza fermata.", "es": "Bájate en la tercera parada.", "options": ["Scendi", "Scenda", "Scendere"], "answer": "Scendi", "why": "Scendere (-ere) con tu: scendi.", "g": "it-g-imperativo-tu-intro" },
    { "id": "e6", "type": "choose", "q": "Hugo, ___ qui!", "es": "¡Hugo, ven aquí!", "options": ["vieni", "venga", "vengo"], "answer": "vieni", "why": "Venire con tu: vieni, como el presente.", "g": "it-g-imperativo-tu-intro" },
    { "id": "e7", "type": "fill", "q": "___ il ponte e poi gira a destra.", "es": "Cruza el puente y luego gira a la derecha.", "answer": ["Attraversa", "attraversa"], "bank": ["Attraversa", "Attraversi", "Attraversare"], "why": "-are → -a: attraversa.", "g": "it-g-imperativo-tu-intro" },
    { "id": "e8", "type": "fill", "q": "___ il lungomare fino al porto.", "es": "Sigue el paseo marítimo hasta el puerto.", "answer": ["Segui", "segui"], "bank": ["Segui", "Segua", "Sega"], "why": "Seguire (-ire): segui.", "g": "it-g-imperativo-tu-intro" },
