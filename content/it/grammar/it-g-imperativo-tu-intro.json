    { "id": "e18", "type": "conjugate", "verb": "aspettare", "person": "tu", "tense": "imperativo", "q": "___ davanti al museo!", "answer": ["Aspetta", "aspetta"], "why": "-are → -a: aspetta (espera).", "g": "it-g-imperativo-tu-intro" },
