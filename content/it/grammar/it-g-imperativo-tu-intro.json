    { "id": "e10", "type": "fill", "q": "___ attenzione alle macchine!", "es": "¡Ten cuidado con los coches!", "answer": ["Fai", "Fa'", "fai"], "bank": ["Fai", "Fare", "Faccia"], "why": "Fare es irregular: fai (o fa'). Fai attenzione = ten cuidado.", "g": "it-g-imperativo-tu-intro" },
    { "id": "e11", "type": "fill", "q": "___ fino al semaforo.", "es": "Continúa hasta el semáforo.", "answer": ["Continua", "continua"], "hint": "continuare, tú", "why": "-are → -a: continua.", "g": "it-g-imperativo-tu-intro" },
