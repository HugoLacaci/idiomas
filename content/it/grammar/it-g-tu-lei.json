  "story": [
    { "kind": "intro", "emoji": "🎩", "title": "¿Tú o usted?",
      "text": "En Italia, como en España, hay dos formas de tratar a la gente: **tu** (confianza) y **Lei** (respeto)." },
    { "kind": "rule", "emoji": "👩", "title": "Lei = usted",
      "text": "Usted se dice **Lei** (a menudo con mayúscula). Y el verbo va como con «ella»: Lei ==è==, Lei ==sta==.",
      "examples": [{ "t": "Lei è spagnola?", "es": "¿Usted es española?", "hl": "è" }] },
    { "kind": "table", "emoji": "📋", "title": "Las frases clave",
      "text": "Fíjate en lo que cambia.",
      "table": { "head": ["", "Tu (tú)", "Lei (usted)"], "rows": [
        ["¿Cómo estás / está?", "Come ==stai==?", "Come ==sta==?"],
        ["¿Cómo te / se llama?", "Come ==ti== chiami?", "Come ==si== chiama?"],
        ["¿De dónde eres / es?", "Di dove ==sei==?", "Di dov'==è==?"],
        ["¿Y tú / usted?", "E ==tu==?", "E ==Lei==?"],
        ["Adiós", "Ciao!", "==ArrivederLa!=="]
      ] } },
    { "kind": "compare", "emoji": "🇪🇸", "title": "Un poco distinto que en España",
      "text": "En Italia se tutea algo menos que en España. Con dependientes, médicos o vecinos mayores, mejor **Lei**." },
    { "kind": "errors", "emoji": "⚠️", "title": "No lo mezcles",
      "text": "Si dices «signora», sigue de usted: Signora, come ==sta==? (no «come stai»). Y aunque hables con un hombre, es **Lei**, no lui." },
    { "kind": "tip", "emoji": "💡", "title": "Pasar al tú",
      "text": "Si alguien te dice **Diamoci del tu!**, ya podéis tutearos. ¡Buena señal!",
      "examples": [{ "t": "Possiamo darci del tu?", "es": "¿Nos tuteamos?", "hl": "darci del tu" }] }
  ],
  "compare": {
    "es": "En español: tú (¿cómo estás?) y usted (¿cómo está?). Usted va con el verbo como «él / ella».",
    "target": "En italiano igual: tu (come stai?) y Lei (come sta?). Lei va con el verbo como «lei» (ella), también si hablas con un hombre."
