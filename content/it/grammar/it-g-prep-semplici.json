  "id": "it-g-prep-semplici",
  "lang": "it",
  "level": "A1",
  "title": "Preposiciones simples (di, a, da, in, con, su, per, tra/fra)",
  "short": "Ocho palabras pequeñas: di legno, a Roma, da Hugo, in cucina, per te…",
  "story": [
    {
      "kind": "intro",
      "emoji": "🧭",
      "title": "Palabras pequeñas, muy útiles",
      "text": "Las preposiciones son «de, a, en, con, para…». En italiano hay ocho y casi todas se parecen al español.",
      "examples": [
        { "t": "Sono a casa con Hugo.", "es": "Estoy en casa con Hugo.", "hl": "a" },
        { "t": "Un tavolo di legno.", "es": "Una mesa de madera.", "hl": "di" }
      ]
    },
    {
      "kind": "table",
      "emoji": "📋",
      "title": "Las ocho",
      "text": "Léelas despacio con su ejemplo.",
      "table": {
        "head": ["Italiano", "Español", "Ejemplo"],
        "rows": [
          ["==di==", "de", "la casa ==di== Hugo"],
          ["==a==", "a, en (ciudades)", "==a== Roma, ==a== casa"],
          ["==da==", "desde; en casa de", "==da== Madrid, ==da== Hugo"],
          ["==in==", "en (países, habitaciones)", "==in== Italia, ==in== cucina"],
          ["==con==", "con", "==con== le amiche"],
          ["==su==", "sobre, encima de", "==su== uno scaffale"],
          ["==per==", "para, por", "==per== te"],
          ["==tra / fra==", "entre; dentro de (tiempo)", "==tra== cinque minuti"]
        ]
      }
    },
    {
      "kind": "rule",
      "emoji": "🗺️",
      "title": "¿A o in?",
      "text": "Ciudades con ==a==: abito ==a== Madrid. Países y regiones con ==in==: ==in== Spagna, ==in== Puglia. Habitaciones con ==in==: ==in== bagno, ==in== camera.",
      "examples": [
        { "t": "Vivo a Madrid, in Spagna.", "es": "Vivo en Madrid, en España.", "hl": "a" }
      ]
    },
    {
      "kind": "compare",
      "emoji": "🏡",
      "title": "La gran novedad: da",
      "text": "==Da== + persona significa «en casa de» o «a casa de». Muy cómodo: en vez de «a casa de Hugo», basta con ==da== Hugo.",
      "examples": [
        { "t": "Stasera vado da Hugo.", "es": "Esta noche voy a casa de Hugo.", "hl": "da" },
        { "t": "Pranzo da un'amica.", "es": "Como en casa de una amiga.", "hl": "da" }
      ]
    },
    {
      "kind": "tip",
      "emoji": "⏳",
      "title": "Tra y fra son gemelas",
      "text": "==Tra== y ==fra== significan lo mismo. Con tiempo, quieren decir «dentro de»: ==tra== dieci minuti = dentro de diez minutos."
    },
    {
      "kind": "errors",
      "emoji": "⚠️",
      "title": "¡Ojo!",
      "text": "❌ a cucina → ✅ ==in== cucina. ❌ in Roma → ✅ ==a== Roma. ❌ de legno → ✅ ==di== legno. ❌ para te → ✅ ==per== te."
    },
    {
      "kind": "tip",
      "emoji": "🔗",
      "title": "Y con el artículo…",
      "text": "Delante de il, la, lo… se juntan: a + il = ==al== (al bar), in + la = ==nella==. Ya conoces «al bar». Las verás en la unidad 9."
    }
  ],
