{
  "id": "it-g-presente-are",
  "lang": "it",
  "level": "A1",
  "title": "El presente de los verbos en -are",
  "short": "Parlo, parli, parla…: el grupo más grande de verbos, muy parecido a nuestro -ar.",
  "story": [
    {
      "kind": "intro",
      "title": "Tu día en verbos",
      "emoji": "☀️",
      "text": "La mayoría de verbos italianos acaban en **-are**, como nuestros verbos en -ar: **parlare** (hablar), **cucinare** (cocinar), **lavorare** (trabajar). ¡Y se conjugan casi igual!",
      "examples": [
        { "t": "Io ==cucino== la paella.", "es": "Yo cocino la paella.", "hl": "cucino" }
      ]
    },
    {
      "kind": "table",
      "title": "Parlare (hablar)",
      "emoji": "🗣️",
      "text": "Quita **-are** y añade la terminación. Fíjate en lo que cambia.",
      "table": {
        "head": ["Persona", "Italiano", "Español"],
        "rows": [
          ["io", "parl==o==", "hablo"],
          ["tu", "parl==i==", "hablas"],
          ["lui / lei / Lei", "parl==a==", "habla"],
          ["noi", "parl==iamo==", "hablamos"],
          ["voi", "parl==ate==", "habláis"],
          ["loro", "parl==ano==", "hablan"]
        ]
      }
    },
    {
      "kind": "compare",
      "title": "Casi como en español",
      "emoji": "🇪🇸",
      "text": "Io parl**o** = yo habl**o**. Pero **tu** acaba en ==-i== (no en -as) y **noi** en ==-iamo== (no en -amos).",
      "examples": [
        { "t": "Tu ==lavori== troppo!", "es": "¡Tú trabajas demasiado!", "hl": "lavori" },
        { "t": "Noi ==mangiamo== alle due.", "es": "Nosotros comemos a las dos.", "hl": "mangiamo" }
      ]
    },
    {
      "kind": "rule",
      "title": "La negación: non",
      "emoji": "🚫",
      "text": "Para negar, pon **non** delante del verbo, como nuestro «no».",
      "examples": [
        { "t": "Hugo ==non== guarda la TV.", "es": "Hugo no ve la tele.", "hl": "non" },
        { "t": "==Non== lavoro il sabato.", "es": "No trabajo los sábados.", "hl": "Non" }
      ]
    },
    {
      "kind": "rule",
      "title": "Pequeños cambios de letra",
      "emoji": "✏️",
      "text": "**cercare, pagare**: añaden h para mantener el sonido: cerc==hi==, pag==hiamo==. **mangiare, studiare**: no repiten la i: mang==i==, stud==iamo==.",
      "table": {
        "head": ["", "tu", "noi"],
        "rows": [
          ["cercare", "cerc==hi==", "cerc==hiamo=="],
          ["pagare", "pag==hi==", "pag==hiamo=="],
          ["mangiare", "mang==i==", "mang==iamo=="]
        ]
      }
    },
    {
      "kind": "errors",
      "title": "Errores típicos",
      "emoji": "⚠️",
      "text": "Cuidado con la -s española en tu y con decir «parlamo».",
      "examples": [
        { "t": "❌ tu parlas → ✅ tu ==parli==", "es": "tú hablas", "hl": "parli" },
        { "t": "❌ noi parlamo → ✅ noi ==parliamo==", "es": "nosotros hablamos", "hl": "parliamo" },
        { "t": "❌ tu cerci → ✅ tu ==cerchi==", "es": "tú buscas", "hl": "cerchi" }
      ]
    },
    {
      "kind": "tip",
      "title": "Truco del acento",
      "emoji": "💡",
      "text": "En **loro** el acento va donde en io: ==PAR==lano, ==LA==vorano, ==CU==cinano. No digas «parLAno».",
      "examples": [
        { "t": "I miei nipoti ==giocano== in giardino.", "es": "Mis nietos juegan en el jardín.", "hl": "giocano" }
      ]
    }
  ],
  "compare": {
    "es": "Hablar: hablo, hablas, habla, hablamos, habláis, hablan.",
    "target": "Parlare: parlo, parli, parla, parliamo, parlate, parlano. El sujeto (io, tu…) se puede omitir, como en español."
  },
