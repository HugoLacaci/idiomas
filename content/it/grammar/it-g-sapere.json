{
  "id": "it-g-sapere",
  "lang": "it",
  "level": "A1",
  "title": "Sapere (y su diferencia con conoscere)",
  "short": "Saber un dato o hacer algo es sapere; conocer un sitio o a alguien es conoscere.",
  "story": [
    {
      "kind": "intro",
      "title": "¿Sabe dónde está…?",
      "emoji": "🤔",
      "text": "De viaje preguntas mucho «¿sabe…?» y contestas «no lo sé». En italiano el verbo es **sapere**, y es irregular pero cortito.",
      "examples": [
        { "t": "Scusi, ==sa== dov'è l'ascensore?", "es": "Perdone, ¿sabe dónde está el ascensor?", "hl": "sa" },
        { "t": "Non lo ==so==.", "es": "No lo sé.", "hl": "so" }
      ]
    },
    {
      "kind": "table",
      "title": "Sapere y conoscere",
      "emoji": "📋",
      "text": "Sapere es irregular; conoscere es regular, pero ojo al sonido: conos**co** (k) y conos**ci** (sh).",
      "table": {
        "head": ["", "sapere (saber)", "conoscere (conocer)"],
        "rows": [
          ["io", "==so==", "conosco"],
          ["tu", "==sai==", "conosci"],
          ["lui / lei / Lei", "==sa==", "conosce"],
          ["noi", "==sappiamo==", "conosciamo"],
          ["voi", "sapete", "conoscete"],
          ["loro", "==sanno==", "conoscono"]
        ]
      }
    },
    {
      "kind": "rule",
      "title": "Sapere: datos y habilidades",
      "emoji": "🧠",
      "text": "Usa **sapere** para un dato (==sai dov'è…?==, ==so che…==) y para saber hacer algo: ==so nuotare==. Detrás puede ir un infinitivo, dove, perché, se, che…",
      "examples": [
        { "t": "==So== cucinare la paella.", "es": "Sé cocinar paella.", "hl": "So" },
        { "t": "Non ==sappiamo== se c'è posto.", "es": "No sabemos si hay sitio.", "hl": "sappiamo" }
      ]
    },
    {
      "kind": "rule",
      "title": "Conoscere: personas y lugares",
      "emoji": "🤝",
      "text": "Usa **conoscere** con personas, ciudades, restaurantes… cosas que has visto o tratado: ==conosco Roma==, ==conosci mia sorella?==",
      "examples": [
        { "t": "==Conosce== un buon ristorante?", "es": "¿Conoce un buen restaurante?", "hl": "Conosce" },
        { "t": "Non ==conosco== Catania.", "es": "No conozco Catania.", "hl": "conosco" }
      ]
    },
    {
      "kind": "compare",
      "title": "Español e italiano",
      "emoji": "🇪🇸",
      "text": "¡Buena noticia! El reparto es igual que en español: saber / sapere, conocer / conoscere. Solo cambia la forma: yo sé = ==io so==.",
      "examples": [
        { "t": "==So== dov'è.", "es": "Sé dónde está.", "hl": "So" },
        { "t": "==Conosco== la strada.", "es": "Conozco el camino.", "hl": "Conosco" }
      ]
    },
    {
      "kind": "errors",
      "title": "Errores típicos",
      "emoji": "⚠️",
      "text": "Cuidado con estos:",
      "examples": [
        { "t": "❌ Io sé → ✅ Io ==so==", "es": "Yo sé", "hl": "so" },
        { "t": "❌ So Roma → ✅ ==Conosco== Roma", "es": "Conozco Roma", "hl": "Conosco" },
        { "t": "❌ Non so → ✅ Non ==lo== so (para responder)", "es": "No lo sé", "hl": "lo" }
      ]
    },
    {
      "kind": "tip",
      "title": "Truco",
      "emoji": "💡",
      "text": "Memoriza dos frases de bolsillo: ==Scusi, sa dov'è…?== para preguntar, y ==Non lo so, mi dispiace== para contestar.",
      "examples": [
        { "t": "Non lo ==so==, mi dispiace.", "es": "No lo sé, lo siento.", "hl": "so" }
      ]
    }
  ],
  "compare": {
    "es": "En español: sé, sabes, sabe (datos y habilidades) y conozco, conoces (personas y lugares).",
    "target": "En italiano igual: so, sai, sa (sapere) y conosco, conosci (conoscere). Yo sé = io so."
  },
  "errors": [
    { "wrong": "Io sé dov'è la stazione.", "right": "Io so dov'è la stazione.", "why": "Yo sé es io so." },
    { "wrong": "Sai mia sorella?", "right": "Conosci mia sorella?", "why": "A una persona se la conoce: conoscere." },
    { "wrong": "Mio marito sa bene Palermo.", "right": "Mio marito conosce bene Palermo.", "why": "Una ciudad se conoce: conoscere." },
    { "wrong": "Noi sapiamo nuotare.", "right": "Noi sappiamo nuotare.", "why": "Sappiamo lleva doble p." },
