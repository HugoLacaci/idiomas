{
  "id": "it-g-irregolari-andare-venire",
  "lang": "it",
  "level": "A1",
  "title": "Irregulares: andare, venire y uscire",
  "short": "Ir, venir y salir: tres verbos de viaje que no siguen las reglas.",
  "story": [
    {
      "kind": "intro",
      "title": "Tres verbos para viajar",
      "emoji": "🧳",
      "text": "Para moverte por Italia necesitas **andare** (ir), **venire** (venir) y **uscire** (salir). Los tres son irregulares, pero se parecen bastante al español.",
      "examples": [
        { "t": "==Vado== a Roma.", "es": "Voy a Roma.", "hl": "Vado" },
        { "t": "==Vieni== con me?", "es": "¿Vienes conmigo?", "hl": "Vieni" },
        { "t": "==Esco== di casa.", "es": "Salgo de casa.", "hl": "Esco" }
      ]
    },
    {
      "kind": "table",
      "title": "Las formas",
      "emoji": "📋",
      "text": "Fíjate: **noi** y **voi** son casi regulares. Lo raro está en io, tu, lui/lei y loro.",
      "table": {
        "head": ["", "andare (ir)", "venire (venir)", "uscire (salir)"],
        "rows": [
          ["io", "==vado==", "==vengo==", "==esco=="],
          ["tu", "==vai==", "==vieni==", "==esci=="],
          ["lui / lei / Lei", "==va==", "==viene==", "==esce=="],
          ["noi", "andiamo", "veniamo", "usciamo"],
          ["voi", "andate", "venite", "uscite"],
          ["loro", "==vanno==", "==vengono==", "==escono=="]
        ]
      }
    },
    {
      "kind": "rule",
      "title": "Uscire: la u se vuelve e",
      "emoji": "🚪",
      "text": "En uscire, cuando el acento cae en la primera sílaba, la u pasa a **e**: ==esco==, ==esci==, ==esce==, ==escono==. Con noi y voi vuelve la u: usciamo, uscite.",
      "examples": [
        { "t": "A che ora ==esci==?", "es": "¿A qué hora sales?", "hl": "esci" },
        { "t": "==Usciamo== stasera?", "es": "¿Salimos esta noche?", "hl": "Usciamo" }
      ]
    },
    {
      "kind": "rule",
      "title": "Andare o venire",
      "emoji": "↔️",
      "text": "**Venire** es moverse hacia donde está la persona con la que hablas. Por eso, cuando te llaman, se contesta ==Vengo!== y no «Vado!».",
      "examples": [
        { "t": "Mamma, vieni? — Sì, ==vengo==!", "es": "Mamá, ¿vienes? —Sí, ¡voy!", "hl": "vengo" },
        { "t": "==Vengo== da Madrid.", "es": "Vengo de Madrid.", "hl": "Vengo" }
      ]
    },
    {
      "kind": "compare",
      "title": "Español e italiano",
      "emoji": "🇪🇸",
      "text": "Vengo, vieni, viene suena casi igual que vengo, vienes, viene. Y **vado** se parece a nuestro antiguo «vo»… pero ¡ojo con **salire**, que es subir!",
      "examples": [
        { "t": "Io ==vengo==, tu ==vieni==", "es": "Yo vengo, tú vienes", "hl": "vengo" },
        { "t": "==Esco== alle otto.", "es": "Salgo a las ocho.", "hl": "Esco" }
      ]
    },
    {
      "kind": "errors",
      "title": "Errores típicos",
      "emoji": "⚠️",
      "text": "Estos se escapan mucho al principio:",
      "examples": [
        { "t": "❌ loro andano → ✅ loro ==vanno==", "es": "ellos van", "hl": "vanno" },
        { "t": "❌ io uscio → ✅ io ==esco==", "es": "yo salgo", "hl": "esco" },
        { "t": "❌ Sì, vado! → ✅ Sì, ==vengo==!", "es": "¡Sí, voy! (cuando te llaman)", "hl": "vengo" }
      ]
    },
    {
      "kind": "tip",
      "title": "Truco",
      "emoji": "💡",
      "text": "Aprende las tres primeras formas como una cancioncilla: ==vado, vai, va== · ==vengo, vieni, viene== · ==esco, esci, esce==. El resto sale casi solo.",
      "examples": [
        { "t": "Vado in stazione. ==Vieni== anche tu?", "es": "Voy a la estación. ¿Vienes tú también?", "hl": "Vieni" }
      ]
    }
  ],
  "compare": {
    "es": "En español decimos voy, vienes, sale, y cuando nos llaman contestamos «¡Voy!».",
    "target": "En italiano: vado, vieni, esce. Salir es uscire (salire es subir) y, cuando te llaman, se contesta «Vengo!»."
  },
  "errors": [
    { "wrong": "Loro andano a Bari.", "right": "Loro vanno a Bari.", "why": "Loro de andare es vanno." },
    { "wrong": "Io uscio alle otto.", "right": "Io esco alle otto.", "why": "Uscire cambia la u por e: esco, esci, esce, escono." },
    { "wrong": "Noi venimo domani.", "right": "Noi veniamo domani.", "why": "Noi siempre acaba en -iamo: veniamo." },
    { "wrong": "Salgo di casa alle nove.", "right": "Esco di casa alle nove.", "why": "Salir es uscire. Salire significa subir." },
    { "wrong": "Mamma, vieni? — Sì, vado!", "right": "Mamma, vieni? — Sì, vengo!", "why": "Cuando vas hacia quien te llama, se usa venire." }
  ],
