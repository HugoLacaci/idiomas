{
  "id": "it-g-passato-prossimo-intro",
  "lang": "it",
  "level": "A1",
  "title": "Lo que hice ayer: ho mangiato, ho visto (introducción)",
  "short": "Primeras frases en pasado con avere: ho mangiato, hai dormito, ho fatto, ho visto.",
  "story": [
    {
      "kind": "intro",
      "title": "Contar lo que hiciste",
      "emoji": "📅",
      "text": "Para contar lo que hiciste ayer, el italiano usa ==ho== + una forma del verbo: ==ho mangiato== (he comido / comí).",
      "examples": [
        { "t": "Ieri ==ho mangiato== la pizza.", "es": "Ayer comí pizza.", "hl": "ho mangiato" },
        { "t": "Stamattina ==ho camminato== molto.", "es": "Esta mañana he caminado mucho.", "hl": "ho camminato" }
      ]
    },
    {
      "kind": "rule",
      "title": "Dos piezas",
      "emoji": "🧩",
      "text": "Es como nuestro «he comido»: ==avere== (ho, hai, ha…) + el ==participio==, que termina en -ato, -uto o -ito.",
      "examples": [
        { "t": "==Ho== ==ballato== tutta la sera.", "es": "He bailado toda la noche." }
      ]
    },
    {
      "kind": "table",
      "title": "Cómo se forma el participio",
      "emoji": "🔧",
      "text": "Quita la terminación del infinitivo y pon la nueva:",
      "table": {
        "head": ["Infinitivo", "Participio", "Ejemplo"],
        "rows": [
          ["mangi==are==", "mangi==ato==", "Ho mangiato."],
          ["av==ere==", "av==uto==", "Ho avuto tempo."],
          ["dorm==ire==", "dorm==ito==", "Ho dormito bene."]
        ]
      }
    },
    {
      "kind": "table",
      "title": "Avere delante",
      "emoji": "👤",
      "text": "Solo cambia avere; el participio se queda igual.",
      "table": {
        "head": ["Persona", "Avere", "Ejemplo"],
        "rows": [
          ["io", "==ho==", "ho cucinato"],
          ["tu", "==hai==", "hai cucinato"],
          ["lui / lei / Lei", "==ha==", "ha cucinato"],
          ["noi", "==abbiamo==", "abbiamo cucinato"]
        ]
      }
    },
    {
      "kind": "compare",
      "title": "«Ayer vi» = «Ieri ho visto»",
      "emoji": "🇪🇸",
      "text": "En España decimos «ayer ==vi== una película». En italiano hablado se usa esta forma también para ayer: ieri ==ho visto== un film.",
      "examples": [
        { "t": "Ieri sera ho visto un film.", "es": "Anoche vi una película." }
      ]
    },
    {
      "kind": "rule",
      "title": "Tres muy frecuentes",
      "emoji": "⭐",
      "text": "Algunos verbos tienen participio especial. Apréndete ya estos tres: ==fatto== (fare), ==visto== (vedere), ==letto== (leggere).",
      "examples": [
        { "t": "Cosa hai fatto ieri?", "es": "¿Qué hiciste ayer?" },
        { "t": "Ho letto un libro.", "es": "He leído un libro." }
      ]
    },
    {
      "kind": "errors",
      "title": "¡Ojo!",
      "emoji": "⚠️",
      "text": "❌ *Ho mangiado* → ✅ ho mangi==ato== (con t). ❌ *Ho vedito* → ✅ ho ==visto==. ❌ *Ho non mangiato* → ✅ ==non ho== mangiato."
    },
    {
      "kind": "tip",
      "title": "Truco",
      "emoji": "💡",
      "text": "La negación va delante de todo, como en español: ==non ho== dormito = no he dormido.",
      "examples": [
        { "t": "Stanotte non ho dormito.", "es": "Esta noche no he dormido." }
      ]
    }
  ],
  "compare": {
    "es": "En España usamos «he comido» para hoy y «comí» para ayer: Hoy he comido paella. Ayer comí pizza.",
    "target": "En italiano hablado se usa ho mangiato para las dos: Oggi ho mangiato la paella. Ieri ho mangiato la pizza."
  },
  "errors": [
    { "wrong": "Ieri ho mangiado la pasta.", "right": "Ieri ho mangiato la pasta.", "why": "El participio italiano lleva t: mangiato, no «mangiado»." },
    { "wrong": "Ho vedito un film.", "right": "Ho visto un film.", "why": "Vedere tiene participio especial: visto, como en español." },
    { "wrong": "Ho non dormito.", "right": "Non ho dormito.", "why": "Non va delante de avere: non ho dormito." },
    { "wrong": "Ieri io mangiato bene.", "right": "Ieri ho mangiato bene.", "why": "Hace falta avere delante: ho mangiato." },
    { "wrong": "Cosa hai facciato?", "right": "Cosa hai fatto?", "why": "Fare tiene participio especial: fatto." }
  ],
