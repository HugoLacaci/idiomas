{
  "id": "it-g-pronomi-soggetto",
  "lang": "it",
  "level": "A1",
  "title": "Los pronombres sujeto (io, tu, lui, lei…)",
  "short": "Quién hace la acción: yo, tú, él, ella, usted, nosotros, vosotros, ellos.",
  "story": [
    { "kind": "intro", "emoji": "👥", "title": "¿Quién es quién?",
      "text": "En italiano, igual que en español, hay palabras para decir **quién** hace algo: yo, tú, ella… ¡Y se parecen mucho!",
      "examples": [{ "t": "Io sono Yolanda.", "es": "Yo soy Yolanda.", "hl": "Io" }] },
    { "kind": "table", "emoji": "📋", "title": "Los pronombres",
      "text": "Mira la tabla: casi todos se parecen al español.",
      "table": { "head": ["Italiano", "Español"], "rows": [
        ["==io==", "yo"],
        ["==tu==", "tú"],
        ["==lui== / ==lei==", "él / ella"],
        ["==Lei==", "usted"],
        ["==noi==", "nosotros / nosotras"],
        ["==voi==", "vosotros / vosotras"],
        ["==loro==", "ellos / ellas"]
      ] } },
    { "kind": "rule", "emoji": "✂️", "title": "Casi siempre se omiten",
      "text": "Como en español, el verbo ya dice quién es. Por eso normalmente **no** se pone: ==Sono== spagnola.",
      "examples": [
        { "t": "Sono spagnola.", "es": "Soy española.", "hl": "Sono" },
        { "t": "Siamo a Roma.", "es": "Estamos en Roma.", "hl": "Siamo" }
      ] },
    { "kind": "rule", "emoji": "☝️", "title": "¿Cuándo se ponen?",
      "text": "Para **contrastar** o dejar claro quién: ==Io== sono spagnola, ==lui== è italiano.",
      "examples": [{ "t": "Io sono spagnola, lui è italiano.", "es": "Yo soy española, él es italiano.", "hl": "Io" }] },
    { "kind": "compare", "emoji": "🎩", "title": "lei y Lei",
      "text": "**lei** es «ella». **Lei** (a menudo con mayúscula) es «usted», y el verbo va igual: Lei ==è== spagnola?",
      "examples": [{ "t": "Lei è spagnola?", "es": "¿Usted es española? / ¿Ella es española?", "hl": "Lei" }] },
    { "kind": "errors", "emoji": "⚠️", "title": "Cuidado con…",
      "text": "No confundas **lui** (él) con **lei** (ella). «Tú» es **tu**, sin acento. Y **loro** vale para ellos y para ellas." },
    { "kind": "tip", "emoji": "💡", "title": "Truco",
      "text": "**Lui** suena casi como «Luis»: es un chico. **Lei**, entonces, es ella. 😉" }
  ],
  "compare": {
    "es": "En español decimos yo, tú, él, ella, usted, nosotros, vosotros, ellos / ellas, y solemos omitirlos.",
    "target": "En italiano: io, tu, lui, lei, Lei, noi, voi, loro. También se omiten casi siempre, y loro sirve para ellos y para ellas."
  },
  "errors": [
    { "wrong": "Lei è mio figlio.", "right": "Lui è mio figlio.", "why": "Para un hombre, lui (él); lei es para una mujer." },
    { "wrong": "Tú sei italiana?", "right": "Tu sei italiana?", "why": "En italiano «tu» no lleva acento." },
    { "wrong": "Yo sono Yolanda.", "right": "Io sono Yolanda.", "why": "«Yo» en italiano es io." },
    { "wrong": "Lore sono le mie amiche.", "right": "Loro sono le mie amiche.", "why": "Loro no cambia: vale para ellos y para ellas." }
  ],
