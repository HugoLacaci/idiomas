  "grammar": "en-g-plurals",
  "pron": {
    "title": "La -s del plural: s, z o iz",
    "tip": "La -s final suena «s» después de p, t, k (books, cups), «z» suave después de casi todo lo demás (bags, keys) y añade una sílaba «iz» después de s, sh, ch, x (glasses, watches, boxes). ¡No te comas la -s! Sin ella, no es plural.",
    "words": [
      "cups",
      "bags",
      "keys",
      "glasses",
      "watches",
      "boxes"
    ],
    "pairs": [
      [
        "bag",
        "bags"
      ],
      [
        "watch",
        "watches"
      ]
    ]
  },
