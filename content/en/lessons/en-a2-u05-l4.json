  "grammar": "en-g-past-did",
  "pron": {
    "title": "was y were: débiles y fuertes",
    "tip": "En mitad de la frase, was suena «uəz» y were «uə», casi sin vocal: It was cold («it-uəz-cold»). Solo suenan fuertes al final: Yes, it was («uoz»). Las negativas wasn't y weren't siempre suenan claras.",
    "words": [
      "It was cold.",
      "We were tired.",
      "Yes, it was.",
      "Yes, we were."
    ],
    "pairs": [
      [
        "was",
        "wasn't"
      ],
      [
        "were",
        "weren't"
      ]
    ]
  },
