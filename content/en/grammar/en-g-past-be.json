{
  "id": "en-g-past-be",
  "lang": "en",
  "level": "A2",
  "title": "Pasado de to be (was / were)",
  "short": "I/he/she/it was; you/we/they were. Negativa: wasn't, weren't. Pregunta: Was she…? Were you…?",
  "story": [
    { "kind": "intro", "title": "Ayer estuve…", "emoji": "📅",
      "text": "**Am, is, are** tienen dos formas en pasado: ==was== y ==were==. Sirven para «fui, era, estuve, estaba».",
      "examples": [
        { "t": "I was at home yesterday.", "es": "Ayer estuve en casa.", "hl": "was" },
        { "t": "The shops were very busy.", "es": "Las tiendas estaban llenísimas.", "hl": "were" }
      ] },
    { "kind": "table", "title": "was o were", "emoji": "📋",
      "text": "==was== con I, he, she, it. ==were== con you, we, they. ¡Ojo! **you** siempre va con were.",
      "table": {
        "head": ["", "Afirmativa", "Negativa", "Pregunta"],
        "rows": [
          ["I", "I ==was== tired.", "I ==wasn't== tired.", "==Was== I late?"],
          ["he / she / it", "It ==was== lovely.", "It ==wasn't== cold.", "==Was== it nice?"],
          ["you", "You ==were== right.", "You ==weren't== there.", "==Were== you at home?"],
          ["we / they", "We ==were== in Edinburgh.", "They ==weren't== busy.", "==Were== they happy?"]
        ]
      } },
    { "kind": "rule", "title": "Respuestas cortas", "emoji": "💬",
      "text": "Responde repitiendo el verbo: Were you at home? — Yes, I ==was==. / No, I ==wasn't==.",
      "examples": [
        { "t": "Was the film good? — Yes, it was.", "es": "¿Estuvo bien la peli? — Sí.", "hl": "it was" },
        { "t": "Were your friends there? — No, they weren't.", "es": "¿Estaban tus amigas? — No.", "hl": "they weren't" }
      ] },
    { "kind": "rule", "title": "Palabras del pasado", "emoji": "⏪",
      "text": "Van con was/were: ==yesterday==, ==last== weekend, ==last== night, two days ==ago==. Y para nacer: I ==was born== in Spain.",
      "examples": [
        { "t": "Where were you last night?", "es": "¿Dónde estuviste anoche?", "hl": "last night" },
        { "t": "I was born in a small village.", "es": "Nací en un pueblo pequeño.", "hl": "was born" }
      ] },
    { "kind": "compare", "title": "Así en español, así en inglés", "emoji": "🇪🇸",
      "text": "En español: fui, era, estuve, estaba… ¡muchas formas! En inglés solo dos: ==was== y ==were==. Y «nací» es ==I was born==.",
      "examples": [
        { "t": "It was a lovely day.", "es": "Fue un día precioso. / Hacía un día precioso.", "hl": "was" }
      ] },
    { "kind": "errors", "title": "Errores típicos", "emoji": "⚠️",
      "text": "❌ You was at home. ✅ You ==were== at home.\n❌ I am born in 1960. ✅ I ==was born== in 1960.\n❌ I was go to the park. ✅ I ==went== to the park.\n❌ Was you tired? ✅ ==Were== you tired?" },
    { "kind": "tip", "title": "Truco: was va con is", "emoji": "💡",
      "text": "Lo que era ==am== o ==is== pasa a ==was==. Lo que era ==are== pasa a ==were==. You are → you were." }
  ],
  "compare": {
    "es": "En español el pasado de ser y estar tiene muchas formas: fui, era, estuve, estaba, fuiste, estábamos… Nacer es un verbo normal: nací.",
    "target": "En inglés solo hay dos: was (I, he, she, it) y were (you, we, they). La negativa añade not (wasn't, weren't) y la pregunta da la vuelta: Were you…? Nací = I was born."
  },
  "errors": [
    { "wrong": "You was very kind.", "right": "You were very kind.", "why": "Con you siempre were, aunque sea una sola persona." },
