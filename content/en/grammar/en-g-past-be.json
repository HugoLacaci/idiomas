    { "wrong": "I was visit my son.", "right": "I visited my son.", "why": "Was no sirve para hacer el pasado de otros verbos: visited." },
    { "wrong": "Was you at home?", "right": "Were you at home?", "why": "La pregunta con you lleva were." },
    { "wrong": "We was in Edinburgh.", "right": "We were in Edinburgh.", "why": "Con we usamos were." },
    { "wrong": "Yesterday I am tired.", "right": "Yesterday I was tired.", "why": "Yesterday habla del pasado: was." }
  ],
